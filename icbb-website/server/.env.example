# ---------------------------------------------------------------------------
# ICBB API — environment template
#
# Copy to `.env` and fill in REAL values there. `.env` is gitignored.
# NEVER put a real secret in this file — it is committed to a public repo.
# ---------------------------------------------------------------------------

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas connection string in production)
MONGODB_URI=mongodb://localhost:27017/icbb_db

# JWT Configuration
# REQUIRED in production — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# Admin account
# Used ONLY by `npm run seed` to create the first admin user.
# Choose a long, unique password and store it in a password manager.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email Configuration (SMTP)
# For Gmail use an App Password, never your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ICBB <noreply@icbb-gh.com>

# Public origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://icbb-gh.com,https://www.icbb-gh.com

# MTN MoMo Configuration
MOMO_ACCOUNT_NAME=
MOMO_ACCOUNT_NUMBER=
MOMO_NETWORK=MTN Ghana
MOMO_API_USER=
MOMO_API_KEY=
MOMO_SUBSCRIPTION_KEY=
MOMO_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=http://localhost:5000/api/payments/callback

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads
# Set when deploying to a serverless host (Vercel) — local disk is not persistent there.
BLOB_READ_WRITE_TOKEN=

# ICBB Contact Information
ICBB_PHONE=
ICBB_EMAIL=info@icbb-gh.com
